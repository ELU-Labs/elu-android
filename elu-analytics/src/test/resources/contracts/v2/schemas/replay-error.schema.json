{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sdk.elu.dev/contracts/v2/replay-error.schema.json",
    "title": "ELU SDK replay transport error v2",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "requestId", "status", "code", "disposition", "conflictScope"],
    "properties": {
        "schemaVersion": { "const": 2 },
        "requestId": { "type": "string", "pattern": "^request_[a-f0-9]{64}$" },
        "status": { "const": 409 },
        "code": { "const": "replay-identity-conflict" },
        "disposition": { "const": "permanent" },
        "conflictScope": { "enum": ["request", "chunk", "sequence"] }
    }
}
