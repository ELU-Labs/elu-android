{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sdk.elu.dev/contracts/v1/batch-ack.schema.json",
    "title": "ELU SDK contiguous-prefix batch acknowledgement v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "requestId", "streamId", "resolvedThroughSequence", "retryFromSequence", "outcomes"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "streamId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "resolvedThroughSequence": { "type": ["integer", "null"], "minimum": 0 },
        "retryFromSequence": { "type": ["integer", "null"], "minimum": 0 },
        "outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": { "$ref": "#/$defs/outcome" }
        }
    },
    "$defs": {
        "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "recordId", "kind", "result"],
            "properties": {
                "sequence": { "type": "integer", "minimum": 0 },
                "recordId": { "type": "string", "minLength": 1, "maxLength": 256 },
                "kind": { "enum": ["mutation", "event"] },
                "result": { "enum": ["accepted", "terminally-rejected", "retryable"] },
                "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
            },
            "allOf": [
                {
                    "if": { "properties": { "result": { "const": "accepted" } } },
                    "then": { "not": { "required": ["code"] } },
                    "else": { "required": ["code"] }
                }
            ]
        }
    }
}
