{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sdk.elu.dev/contracts/v1/transport-error.schema.json",
    "title": "ELU SDK HTTP transport error response v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "status", "code", "disposition", "message"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "status": {
            "anyOf": [{ "enum": [401, 403, 413, 429] }, { "type": "integer", "minimum": 500, "maximum": 599 }]
        },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "disposition": { "enum": ["permanent", "retry-after-reduction", "retryable"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "allOf": [
        {
            "if": { "properties": { "status": { "enum": [401, 403] } } },
            "then": { "properties": { "disposition": { "const": "permanent" } } }
        },
        {
            "if": { "properties": { "status": { "const": 413 } } },
            "then": { "properties": { "disposition": { "const": "retry-after-reduction" } } }
        },
        {
            "if": { "properties": { "status": { "const": 429 } } },
            "then": { "properties": { "disposition": { "const": "retryable" } } }
        },
        {
            "if": { "properties": { "status": { "type": "integer", "minimum": 500, "maximum": 599 } } },
            "then": { "properties": { "disposition": { "const": "retryable" } } }
        }
    ]
}
