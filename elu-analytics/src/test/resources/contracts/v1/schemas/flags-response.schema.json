{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sdk.elu.dev/contracts/v1/flags-response.schema.json",
    "title": "ELU SDK feature flag response v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "requestId",
        "contextRevision",
        "identityRevision",
        "flagsRevision",
        "evaluatedAt",
        "expiresAt",
        "flags",
        "payloads"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contextRevision": { "type": "integer", "minimum": 0 },
        "identityRevision": { "type": "integer", "minimum": 0 },
        "flagsRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "flags": {
            "type": "object",
            "additionalProperties": { "type": ["boolean", "string", "number", "null"] }
        },
        "payloads": { "type": "object" }
    }
}
