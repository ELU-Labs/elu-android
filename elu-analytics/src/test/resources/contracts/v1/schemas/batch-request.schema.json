{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sdk.elu.dev/contracts/v1/batch-request.schema.json",
    "title": "ELU SDK ordered event and mutation batch request v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "requestId", "streamId", "sentAt", "versions", "records"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "streamId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sentAt": { "type": "string", "format": "date-time" },
        "versions": { "$ref": "version.schema.json" },
        "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
                "oneOf": [{ "$ref": "#/$defs/mutationRecord" }, { "$ref": "#/$defs/eventRecord" }]
            }
        }
    },
    "$defs": {
        "mutationRecord": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "mutation"],
            "properties": {
                "kind": { "const": "mutation" },
                "mutation": { "$ref": "mutation.schema.json#/$defs/mutation" }
            }
        },
        "eventRecord": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "event"],
            "properties": {
                "kind": { "const": "event" },
                "event": { "$ref": "event.schema.json" }
            }
        }
    }
}
