{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sdk.elu.dev/contracts/v1/replay-ack.schema.json",
    "title": "ELU SDK replay chunk acknowledgement v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "requestId", "replayId", "chunkId", "sequence", "result"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "replayId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "chunkId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sequence": { "type": "integer", "minimum": 0 },
        "result": { "const": "accepted" }
    }
}
