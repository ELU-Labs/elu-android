{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://sdk.elu.dev/contracts/v1/config.schema.json",
    "title": "ELU SDK configuration response v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "revision", "issuedAt", "expiresAt", "status"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["enabled", "disabled", "revoked"] },
        "site": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
        },
        "endpoints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["events", "flags"],
            "properties": {
                "events": { "type": "string", "format": "uri", "pattern": "^https://" },
                "replay": { "type": "string", "format": "uri", "pattern": "^https://" },
                "flags": { "type": "string", "format": "uri", "pattern": "^https://" },
                "assets": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
        },
        "privacy": { "$ref": "privacy-policy.schema.json" },
        "features": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capture", "replay", "flags", "assets"],
            "properties": {
                "capture": { "type": "boolean" },
                "replay": { "type": "boolean" },
                "flags": { "type": "boolean" },
                "assets": { "type": "boolean" }
            }
        },
        "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["replay"],
            "properties": {
                "replay": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["acceptedCodecs", "acceptedCompressions"],
                    "properties": {
                        "acceptedCodecs": {
                            "type": "array",
                            "maxItems": 32,
                            "items": { "type": "string", "pattern": "^elu-[a-z0-9][a-z0-9.-]{0,63}$" },
                            "uniqueItems": true
                        },
                        "acceptedCompressions": {
                            "type": "array",
                            "maxItems": 8,
                            "items": { "enum": ["none", "gzip"] },
                            "uniqueItems": true
                        }
                    }
                }
            }
        },
        "session": {
            "type": "object",
            "additionalProperties": false,
            "required": ["idleTimeoutSeconds", "maximumDurationSeconds"],
            "properties": {
                "idleTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 36000 },
                "maximumDurationSeconds": { "const": 86400 }
            }
        },
        "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eventBatchCount", "eventBatchBytes", "replayChunkBytes", "queueBytes"],
            "properties": {
                "eventBatchCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "eventBatchBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 },
                "replayChunkBytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 },
                "queueBytes": { "type": "integer", "minimum": 1024, "maximum": 268435456 }
            }
        },
        "reason": { "type": "string", "maxLength": 256 }
    },
    "allOf": [
        {
            "if": { "properties": { "status": { "const": "enabled" } } },
            "then": { "required": ["site", "endpoints", "privacy", "features", "capabilities", "session", "limits"] },
            "else": {
                "required": ["reason"],
                "not": { "anyOf": [{ "required": ["endpoints"] }, { "required": ["site"] }] }
            }
        },
        {
            "if": {
                "properties": { "features": { "properties": { "replay": { "const": true } } } },
                "required": ["features"]
            },
            "then": {
                "properties": {
                    "endpoints": { "required": ["replay"] },
                    "capabilities": {
                        "properties": {
                            "replay": {
                                "properties": {
                                    "acceptedCodecs": { "minItems": 1 },
                                    "acceptedCompressions": { "minItems": 1 }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": { "features": { "properties": { "assets": { "const": true } } } },
                "required": ["features"]
            },
            "then": { "properties": { "endpoints": { "required": ["assets"] } } }
        }
    ]
}
