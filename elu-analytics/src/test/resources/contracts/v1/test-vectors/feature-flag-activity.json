    "scenarios": [
        {
            "id": "install-and-read-complete-snapshot",
            "steps": [
                {
                    "type": "applyConfig",
                    "config": "configAllowedEquivalentBytes",
                    "wallNow": "2026-08-04T00:01:00.000Z",
                    "expect": {
                        "authorization": "allowed",
                        "barrierGeneration": 1,
                        "lastObservedWall": "2026-08-04T00:01:00.000Z"
                    }
                },
                {
                    "type": "beginReload",
                    "requestId": "flags_request_1",
                    "storeEpoch": "store_epoch_1",
                    "wallNow": "2026-08-04T00:01:01.000Z",
                    "expect": {
                        "requestGeneration": 1,
                        "barrierGeneration": 1,
                        "requestCanonicalSha256": "sha256:f5de81f5fcfb0ed0eeb3b5ba7f64430a82332bb5077175e5474e42512139f568"
                    }
                },
                {
                    "type": "completeReload",
                    "requestId": "flags_request_1",
                    "response": "responseMixedValues",
                    "wallNow": "2026-08-04T00:01:02.000Z",
                    "expect": {
                        "result": "updated",
                        "flagsRevision": "flags-mixed-1"
                    }
                },
                {
                    "type": "readAll",
                    "wallNow": "2026-08-04T00:01:03.000Z",
                    "expect": {
