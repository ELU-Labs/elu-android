            "steps": [
                {
                    "type": "seedScenario",
                    "scenario": "install-and-read-complete-snapshot"
                },
                {
                    "type": "injectCacheCorruption",
                    "kind": "digest-mismatch"
                },
                {
                    "type": "beginReload",
                    "requestId": "flags_request_recovery",
                    "storeEpoch": "store_epoch_2",
                    "wallNow": "2026-08-04T00:01:04.000Z",
                    "expect": {
                        "result": "begun",
                        "barrierGeneration": 1,
                        "storeEpoch": "store_epoch_2",
                        "requestGeneration": 1,
                        "authorityPreserved": true
                    }
                }
            ]
        },
        {
            "id": "authority-corruption-is-terminal",
            "steps": [
                {
                    "type": "applyConfig",
                    "config": "configAllowed",
                    "wallNow": "2026-08-04T00:01:00.000Z",
                    "expect": {
                        "authorization": "allowed"
                    }
                },
                {
                    "type": "injectAuthorityCorruption",
                    "kind": "missing-after-initialized"
                },
                {
                    "type": "beginReload",
                    "requestId": "flags_request_after_authority_corruption",
                    "wallNow": "2026-08-04T00:01:01.000Z",
                    "expect": {
                        "result": "terminal",
                        "storageMutation": false
                    }
                }
            ]
        },
