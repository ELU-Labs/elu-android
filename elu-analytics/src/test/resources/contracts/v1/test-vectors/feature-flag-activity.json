        {
            "id": "older-completion-cannot-overwrite-newer-begin",
            "steps": [
                {
                    "type": "applyConfig",
                    "config": "configAllowed",
                    "wallNow": "2026-08-04T00:01:00.000Z",
                    "expect": {
                        "authorization": "allowed"
                    }
                },
                {
                    "type": "beginReload",
                    "realm": "A",
                    "requestId": "flags_request_old",
                    "wallNow": "2026-08-04T00:01:01.000Z",
                    "expect": {
                        "requestGeneration": 1
                    }
                },
                {
                    "type": "beginReload",
                    "realm": "B",
                    "requestId": "flags_request_1",
                    "wallNow": "2026-08-04T00:01:02.000Z",
                    "expect": {
                        "requestGeneration": 2
                    }
                },
                {
                    "type": "completeReload",
                    "realm": "A",
                    "requestId": "flags_request_old",
                    "response": "responseMixedValues",
                    "wallNow": "2026-08-04T00:01:03.000Z",
                    "expect": {
                        "result": "stale"
                    }
                },
                {
                    "type": "completeReload",
                    "realm": "B",
                    "requestId": "flags_request_1",
                    "response": "responseMixedValues",
                    "wallNow": "2026-08-04T00:01:04.000Z",
                    "expect": {
                        "result": "updated",
                        "requestGeneration": 2
                    }
                }
            ]
        },
