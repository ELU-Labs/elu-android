                {
                    "type": "beginReload",
                    "requestId": "flags_request_after_expiry",
                    "wallNow": "2026-08-04T00:04:00.000Z",
                    "expect": {
                        "result": "begun",
                        "barrierGeneration": 1,
                        "requestGeneration": 3
                    }
                }
            ]
        },
        {
            "id": "config-expiry-is-durable-restriction",
